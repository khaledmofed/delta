APP_NAME="Delta Insurance"
APP_ENV=uat
APP_KEY=
APP_DEBUG=false
APP_URL=https://uat.deltains-brokers.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delta
DB_USERNAME=delta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@deltains-brokers.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Insurer integrations — fill on the server only. Never commit values.
# ------------------------------------------------------------------

# Dubai Insurance (DIN) — IIRIS Motor Policy API, spec V0.0.3
DIN_ENABLED=true
DIN_BASE_URL=https://uatbrokerportal.dubins.ae
DIN_USERNAME=
DIN_PASSWORD=
DIN_TIMEOUT=30

# Al Wathba (AWNIC) — Insure API, Motor Aggregators
AWNIC_ENABLED=true
AWNIC_BASE_URL=https://insurance-uat.awnic.com/InsureApiBYUAT/API
AWNIC_PARTNER_ID=
AWNIC_API_KEY=
AWNIC_CUSTOMER_CODE=
AWNIC_TIMEOUT=30

# Where insurers send the customer back after payment
PAYMENT_RETURN_SUCCESS_URL="${APP_URL}/motor/payment/return/success"
PAYMENT_RETURN_FAIL_URL="${APP_URL}/motor/payment/return/fail"
